---
import astroLogo from "../assets/astro.svg";
import background from "../assets/background.svg";
import { Icon } from "astro-icon/components";
import "../styles/global.css";
---

<div id="container" class="p-4">
  <div>
    <h1>Hi, I'm Brian Jia</h1>
    <h2>Electrical & Computer Engineering</h2>
    <h2 class="mb-4">Senior</h2>
    <h2 class="mb-2">
      at <b class="text-red-700">The Ohio State University</b>
    </h2>
    <p class="mb-8">Expected graduation in <b class="text-red-700">May 2027.</b></p>

    <div class="text-muted">
      <a
        class="inline-block mr-4"
        href="https://www.linkedin.com/in/brian-jia-411629225/"
      >
        <Icon class="w-8 h-8 m-auto" name="tabler:brand-linkedin" />
        <p>LinkedIn</p>
      </a>
      <a class="inline-block mr-4" href="https://github.com/Powerlated">
        <Icon class="w-8 h-8 m-auto" name="tabler:brand-github" />
        <p>GitHub</p>
      </a>
    </div>

    <p class="text-xl md:text-2xl text-bold text-muted mt-5 mb-10">
      I make cool things!
    </p>

    <div class="bg-red-700 text-white text-2xl font-bold px-4 py-4">
      Scroll down to see my resume, in portfolio form!
    </div>

    <p class="text-muted mt-2">Resume last updated on 9/29/2026.</p>
  </div>
</div>

<style>
  #container {
    display: flex;
    justify-content: center;
    align-items: center; /* Vertical alignment */
    height: 100vh; /* Full viewport height (optional) */
  }
</style>
